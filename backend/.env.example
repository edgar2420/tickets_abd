# ----- Servidor -----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ----- Base de datos PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=tickets_app
DB_PASSWORD=tickets_app
DB_NAME=tickets_ti
DB_POOL_MAX=10

# ----- Rol de ejecucion con privilegios recortados -----
# La API no debe conectarse con la cuenta dueña de las tablas, que puede
# borrarlas. Cree el rol de trabajo con: npm run privilegios
# Luego apunte DB_USER y DB_PASSWORD de arriba a este rol.
DB_APP_USER=tickets_api
DB_APP_PASSWORD=cambie-esto-por-una-clave-generada
# Credenciales administradoras, solo para ejecutar npm run privilegios
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# ----- Seguridad -----
# En produccion el servicio se niega a arrancar si estas claves conservan
# el valor de ejemplo o tienen menos de 24 caracteres.
# Genere una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Enviar la cookie de sesion solo por HTTPS. Dejar en true de cara a
# internet; ponerlo en false unicamente en una red interna sin certificado.
COOKIE_SECURE=true

# Reconducir a HTTPS toda peticion que llegue en claro. Activar de cara a
# internet; dejar en false en una red interna sin certificado.
FORZAR_HTTPS=false

# ----- Cifrado de credenciales de acceso remoto -----
CLAVE_CIFRADO=cambie-esta-semilla-por-una-cadena-larga-y-aleatoria

# Admitir el acceso desde otras maquinas de la red local. Con esto el servidor
# suma sus propias direcciones IPv4 a los origenes permitidos, de modo que
# funciona aunque la direccion cambie. Dejar en false de cara a internet.
RED_LOCAL=false

# ----- Origenes permitidos (web y movil) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:19006,http://localhost:8081

# ----- Repositorio documental (PDF generados automaticamente) -----
DOCS_OUTPUT_DIR=storage/documentos
REGISTRO_APROBACION=false
