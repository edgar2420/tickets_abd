# =====================================================================
# Plantilla para el despliegue con Docker Compose
# Copie este archivo como .env y reemplace cada valor de ejemplo
# =====================================================================

# Credenciales de la base de datos
DB_USER=tickets_app
DB_PASSWORD=cambie-esta-clave
DB_NAME=tickets_ti
DB_PORT_EXPUESTO=5432

# Seguridad de la API
# Genere cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cadena-larga-y-aleatoria-para-firmar-los-tokens
CLAVE_CIFRADO=cadena-larga-y-aleatoria-para-cifrar-las-credenciales-remotas
JWT_EXPIRES_IN=8h

# Cuenta administradora que se crea en el primer arranque
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambie-esta-clave-de-diez-o-mas

# Puertos publicados
API_PORT=4000
WEB_PORT=8080

# Origenes desde los que se entra. En Docker hay que listarlos a mano: el
# contenedor no ve la red de la maquina anfitriona. Agregue la direccion real,
# por ejemplo http://192.168.0.37:8080
CORS_ORIGINS=http://localhost:8080,http://192.168.0.37:8080

# COOKIE_SECURE solo puede ir en true detras de HTTPS. Sobre HTTP el navegador
# no devuelve la cookie de sesion y el sistema deja de responder tras entrar.
COOKIE_SECURE=false
FORZAR_HTTPS=false
